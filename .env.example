NODE_ENV=development
PORT=5000
# Public URL of the client (used in verification and password-reset links)
CLIENT_URL=http://localhost:5173
# Extra browser origins allowed to call the API, comma-separated. CLIENT_URL is always allowed.
# Use this when the client and API are deployed on different domains.
# CORS_ORIGINS=https://app.example.com,https://www.example.com
# Set true to force Secure cookies. When omitted, the API enables them automatically on HTTPS.
COOKIE_SECURE=false
# Optional cookie domain for cross-subdomain deployments
# COOKIE_DOMAIN=

# Client API base. Use a relative path only when the client is proxied to the API on the
# same origin. Use an absolute URL (e.g. https://api.example.com/api/v1) for split hosting.
VITE_API_URL=/api/v1

# MongoDB Atlas (recommended) or a local MongoDB instance
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=hiresphere

# Use long, random secrets (16+ characters each)
JWT_ACCESS_SECRET=replace-with-at-least-16-characters
JWT_REFRESH_SECRET=replace-with-another-16-plus-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary is required for avatar, company logo, and resume uploads
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
CLOUDINARY_FOLDER=hiresphere

# Transactional email. Set SMTP_PASS or RESEND_API_KEY.
RESEND_API_KEY=re_your_api_key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_api_key
SMTP_FROM=onboarding@resend.dev

# Google Identity Services. Only the client ID is needed for the ID-token flow.
GOOGLE_CLIENT_ID=

# Optional OpenAI-compatible AI provider. AI endpoints return 503 when unset.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Admin bootstrap values used by `npm run seed:admin --workspace server`
ADMIN_EMAIL=admin@hiresphere.local
ADMIN_PASSWORD=replace-with-a-strong-12-plus-character-password
